# Banco de dados PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/motostock
DATABASE_URL="file:./dev.db"

# Servidor
PORT=3333
NODE_ENV=development

# CORS - URL do front-end (React)
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="troque-este-valor-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="troque-este-valor-tambem-por-outro-segredo-forte"
JWT_REFRESH_EXPIRES_IN="7d"

# Upload de arquivos (fotos de produtos)
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5
